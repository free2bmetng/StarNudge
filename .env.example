# Copy to .env.local and fill in. Never commit real values.

# Runtime connection. starnudge_app is the least-privilege role subject to row-level security.
DATABASE_URL=postgres://starnudge_app:starnudge_app_dev@localhost:5432/starnudge
# Owner connection, used only by `npm run db:migrate` to create tables and the runtime role.
MIGRATION_DATABASE_URL=postgres://postgres@localhost:5432/starnudge
APP_DB_PASSWORD=starnudge_app_dev

APP_BASE_URL=http://localhost:3000

# true = every provider is a local sandbox. Nothing reaches a real person.
SANDBOX_MODE=true

# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# Any long random string. Keys contact hashes and signs unsubscribe links.
APP_HASH_KEY=

# Protects POST /api/cron/dispatch. Generate with: openssl rand -hex 32
CRON_SECRET=
SANDBOX_WEBHOOK_SECRET=sandbox-webhook-secret

NOTIFY_FROM_EMAIL=StarNudge <notify@example.com>
PRICE_LABEL=Price to be set by the owner

# Live providers (only read when SANDBOX_MODE=false)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
